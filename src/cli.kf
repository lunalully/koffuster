Config withExcludeLength(Config c, String v) { return Config(c.url(), c.wordlist(), c.extensions(), c.threads(), c.timeoutSec(), c.retries(), c.output(), c.format(), c.headers(), c.cookie(), c.auth(), c.userAgent(), c.proxy(), c.domain(), c.resolver(), c.body(), c.method(), c.endpoint(), c.statusInclude(), c.excludeStatus(), v, c.quiet(), c.color(), c.verbose(), c.help(), c.valid(), c.errorMsg(), c.port()) }
Config withQuiet(Config c, Bool v) { return Config(c.url(), c.wordlist(), c.extensions(), c.threads(), c.timeoutSec(), c.retries(), c.output(), c.format(), c.headers(), c.cookie(), c.auth(), c.userAgent(), c.proxy(), c.domain(), c.resolver(), c.body(), c.method(), c.endpoint(), c.statusInclude(), c.excludeStatus(), c.excludeLength(), v, c.color(), c.verbose(), c.help(), c.valid(), c.errorMsg(), c.port()) }
Config withColor(Config c, Bool v) { return Config(c.url(), c.wordlist(), c.extensions(), c.threads(), c.timeoutSec(), c.retries(), c.output(), c.format(), c.headers(), c.cookie(), c.auth(), c.userAgent(), c.proxy(), c.domain(), c.resolver(), c.body(), c.method(), c.endpoint(), c.statusInclude(), c.excludeStatus(), c.excludeLength(), c.quiet(), v, c.verbose(), c.help(), c.valid(), c.errorMsg(), c.port()) }
Config withVerbose(Config c, Bool v) { return Config(c.url(), c.wordlist(), c.extensions(), c.threads(), c.timeoutSec(), c.retries(), c.output(), c.format(), c.headers(), c.cookie(), c.auth(), c.userAgent(), c.proxy(), c.domain(), c.resolver(), c.body(), c.method(), c.endpoint(), c.statusInclude(), c.excludeStatus(), c.excludeLength(), c.quiet(), c.color(), v, c.help(), c.valid(), c.errorMsg(), c.port()) }
