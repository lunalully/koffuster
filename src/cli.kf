// cli.kf - parser de argumentos e textos de ajuda (KOF 0.5.0).
//
// Simplificação da CLI em relação à 0.1.0: threads aceita QUALQUER número
// (spawn dinâmico), flags sem efeito removidas (-k/--insecure,
// --no-banner, --delay, --rate, --wildcard-tests), e os helps por modo
// ficaram diretos.

record Config(
    String url,
    String wordlist,
    String extensions,
    Int threads,
    Int timeoutSec,
    Int retries,
    String output,
    String format,
    List<String> headers,
    String cookie,
    String auth,
    String userAgent,
    String proxy,
    String domain,
    String resolver,
    String body,
    String method,
    String endpoint,
    String statusInclude,
    String excludeStatus,
    String excludeLength,
    Bool quiet,
    Bool color,
    Bool verbose,
    Bool help,
    Bool valid,
    String errorMsg,
    Int port
)

Config defaultConfig() {
    return Config(
        "", "", "", 8, 10, 1, "", "text",
        listOf<String>(), "", "", "koffuster/0.2",
        "", "", "https://dns.google/resolve", "", "GET", "",
        "", "", "",
        false, false, false, false, true, "", 69
    )
}

Bool argIs(String a, String short_, String long_) {
    if (a == short_) { return true }
    if (a == long_) { return true }
    return false
}

String optValueInline(String a) {
    var eq = a.indexOf("=")
    if (eq < 0) { return "" }
    return a.substring(eq + 1)
}
String optNameInline(String a) {
    var eq = a.indexOf("=")
    if (eq < 0) { return a }
    return a.substring(0, eq)
}

// Forma curta (posicional): koffuster <modo> <alvo> <wordlist>. Sem
// esquema, dir/vhost/fuzz assumem https:// (para http://, digite o
// esquema); dns usa domínio puro e s3/gcs só têm a wordlist.
String normalizeTargetUrl(String mode, String v) {
    if (mode == "dir" || mode == "vhost" || mode == "fuzz") {
        if (v.contains("://") == false) {
            return "https://" + v
        }
    }
    return v
}

String usageLine(String mode) {
    if (mode == "dir") { return "koffuster dir <url> <wordlist> [opções]" }
    if (mode == "dns") { return "koffuster dns <domínio> <wordlist> [opções]" }
    if (mode == "vhost") { return "koffuster vhost <url> <wordlist> [opções]" }
    if (mode == "fuzz") { return "koffuster fuzz <url-com-FUZZ> <wordlist> [opções]" }
    if (mode == "tftp") { return "koffuster tftp <servidor[:porta]> <wordlist> [opções]" }
    return "koffuster " + mode + " <wordlist> [opções]"
}

// Preenche os campos vazios na ordem do modo; sobra vira erro de uso.
Config addPositional(Config c, String mode, String v) {
    if (mode == "dir" || mode == "vhost" || mode == "fuzz") {
        if (c.url().length() == 0) { return withUrl(c, normalizeTargetUrl(mode, v)) }
        if (c.wordlist().length() == 0) { return withWordlist(c, v) }
        return invalidConfig("argumento extra: '" + v + "' (uso: " + usageLine(mode) + ")")
    }
    if (mode == "dns") {
        if (c.domain().length() == 0) { return withDomain(c, v) }
        if (c.wordlist().length() == 0) { return withWordlist(c, v) }
        return invalidConfig("argumento extra: '" + v + "' (uso: " + usageLine(mode) + ")")
    }
    if (mode == "s3" || mode == "gcs") {
        if (c.wordlist().length() == 0) { return withWordlist(c, v) }
        return invalidConfig("argumento extra: '" + v + "' (uso: " + usageLine(mode) + ")")
    }
    if (mode == "tftp") {
        if (c.url().length() == 0) { return withUrl(c, v) }
        if (c.wordlist().length() == 0) { return withWordlist(c, v) }
        return invalidConfig("argumento extra: '" + v + "' (uso: " + usageLine(mode) + ")")
    }
    return invalidConfig("argumento inesperado: '" + v + "'")
}

// Um parser único para todos os modos; `mode` define quais campos são
// obrigatórios ao final (dir/vhost/fuzz precisam de -u; dns de -d; todos
// de -w, exceto tftp que se recusa a rodar).
Config parseModeArgs(String[] args, Int startIdx, String mode) {
    var c = defaultConfig()
    var i = startIdx
    while (i < args.length) {
        var raw = args[i]
        var name = optNameInline(raw)
        var inlineVal = optValueInline(raw)
        var hasInline = raw.contains("=")

        if (argIs(name, "-h", "--help")) {
            c = withHelp(c, true)
            i = i + 1
            continue
        }
        if (argIs(name, "-q", "--quiet") || argIs(name, "-silent", "--silent")) {
            c = withQuiet(c, true)
            i = i + 1
            continue
        }
        if (name == "--color") {
            c = withColor(c, true)
            i = i + 1
            continue
        }
        if (argIs(name, "-v", "--verbose")) {
            c = withVerbose(c, true)
            i = i + 1
            continue
        }

        var isKnownValueOpt = false
        if (argIs(name, "-u", "--url")) { isKnownValueOpt = true }
        else if (argIs(name, "-w", "--wordlist")) { isKnownValueOpt = true }
        else if (argIs(name, "-x", "--extensions")) { isKnownValueOpt = true }
        else if (argIs(name, "-t", "--threads")) { isKnownValueOpt = true }
        else if (name == "--timeout") { isKnownValueOpt = true }
        else if (name == "--retries") { isKnownValueOpt = true }
        else if (argIs(name, "-o", "--output")) { isKnownValueOpt = true }
        else if (argIs(name, "-f", "--format")) { isKnownValueOpt = true }
        else if (argIs(name, "-H", "--header")) { isKnownValueOpt = true }
        else if (name == "--cookie") { isKnownValueOpt = true }
        else if (name == "--auth") { isKnownValueOpt = true }
        else if (argIs(name, "-a", "--user-agent")) { isKnownValueOpt = true }
        else if (name == "--proxy") { isKnownValueOpt = true }
        else if (argIs(name, "-s", "--status")) { isKnownValueOpt = true }
        else if (argIs(name, "-b", "--exclude-status")) { isKnownValueOpt = true }
        else if (name == "--exclude-length") { isKnownValueOpt = true }
        else if (argIs(name, "-d", "--domain")) { isKnownValueOpt = true }
        else if (name == "--resolver") { isKnownValueOpt = true }
        else if (name == "--body") { isKnownValueOpt = true }
        else if (argIs(name, "-X", "--method")) { isKnownValueOpt = true }
        else if (name == "--endpoint") { isKnownValueOpt = true }
        else if (name == "--server") { isKnownValueOpt = true }
        else if (name == "--port") { isKnownValueOpt = true }

        if (isKnownValueOpt == false) {
            // Forma curta: argumento posicional. O primeiro preenche o
            // alvo do modo (url/domínio - ou a wordlist, no s3/gcs), o
            // segundo a wordlist. "-" sozinho vale como wordlist (stdin).
            if (raw == "-" || raw.startsWith("-") == false) {
                var positioned = addPositional(c, mode, raw)
                if (positioned.valid() == false) {
                    return positioned
                }
                c = positioned
                i = i + 1
                continue
            }
            return invalidConfig("opção desconhecida: " + raw)
        }

        var value = ""
        var consumed = 1
        if (hasInline) {
            value = inlineVal
        } else {
            if (i + 1 >= args.length) {
                return invalidConfig("faltou o valor de " + raw)
            }
            value = args[i + 1]
            consumed = 2
        }

        var isNumOpt = false
        if (argIs(name, "-t", "--threads")) { isNumOpt = true }
        else if (name == "--timeout") { isNumOpt = true }
        else if (name == "--retries") { isNumOpt = true }
        else if (name == "--port") { isNumOpt = true }
        if (isNumOpt) {
            var num = toIntOr(value, -1)
            if (num < 0) {
                return invalidConfig("valor inválido para " + name + ": '" + value + "' (esperava um inteiro >= 0)")
            }
            if (num == 0 && argIs(name, "-t", "--threads")) {
                return invalidConfig("valor inválido para " + name + ": precisa ser >= 1")
            }
        }

        if (argIs(name, "-u", "--url")) { c = withUrl(c, normalizeTargetUrl(mode, value)) }
        else if (argIs(name, "-w", "--wordlist")) { c = withWordlist(c, value) }
        else if (argIs(name, "-x", "--extensions")) { c = withExtensions(c, value) }
        else if (argIs(name, "-t", "--threads")) { c = withThreads(c, toIntOr(value, 8)) }
        else if (name == "--timeout") { c = withTimeout(c, toIntOr(value, 10)) }
        else if (name == "--retries") { c = withRetries(c, toIntOr(value, 1)) }
        else if (argIs(name, "-o", "--output")) { c = withOutput(c, value) }
        else if (argIs(name, "-f", "--format")) {
            if (value != "text" && value != "jsonl") {
                return invalidConfig("--format precisa ser text ou jsonl, veio: " + value)
            }
            c = withFormat(c, value)
        }
        else if (argIs(name, "-H", "--header")) { c = withHeaderAdded(c, value) }
        else if (name == "--cookie") { c = withCookie(c, value) }
        else if (name == "--auth") { c = withAuth(c, value) }
        else if (argIs(name, "-a", "--user-agent")) { c = withUserAgent(c, value) }
        else if (name == "--proxy") { c = withProxy(c, value) }
        else if (argIs(name, "-s", "--status")) { c = withStatusInclude(c, value) }
        else if (argIs(name, "-b", "--exclude-status")) { c = withExcludeStatus(c, value) }
        else if (name == "--exclude-length") { c = withExcludeLength(c, value) }
        else if (argIs(name, "-d", "--domain")) { c = withDomain(c, value) }
        else if (name == "--resolver") { c = withResolver(c, value) }
        else if (name == "--body") { c = withBody(c, value) }
        else if (argIs(name, "-X", "--method")) { c = withMethod(c, value.toUpperCase()) }
        else if (name == "--endpoint") { c = withEndpoint(c, value) }
        else if (name == "--server") { c = withUrl(c, value) }
        else if (name == "--port") { c = withPort(c, toIntOr(value, 69)) }
        else {
            return invalidConfig("opção desconhecida: " + raw)
        }

        i = i + consumed
    }

    if (c.help()) { return c }

    if (mode == "dir" || mode == "vhost" || mode == "fuzz") {
        if (c.url().length() == 0) {
            return invalidConfig("falta o alvo (uso: " + usageLine(mode) + "; veja: koffuster help " + mode + ")")
        }
    }
    if (mode == "dns") {
        if (c.domain().length() == 0) {
            return invalidConfig("falta o domínio (uso: " + usageLine(mode) + "; veja: koffuster help dns)")
        }
    }
    if (mode == "tftp") {
        if (c.url().length() == 0) {
            return invalidConfig("falta o servidor (uso: " + usageLine(mode) + "; veja: koffuster help tftp)")
        }
    }
    if (mode == "dir" || mode == "dns" || mode == "vhost" || mode == "fuzz" || mode == "s3" || mode == "gcs" || mode == "tftp") {
        if (c.wordlist().length() == 0) {
            return invalidConfig("falta a wordlist (uso: " + usageLine(mode) + "; veja: koffuster help " + mode + ")")
        }
    }
    return c
}

Config parseDirArgs(String[] args, Int startIdx) {
    return parseModeArgs(args, startIdx, "dir")
}

Config invalidConfig(String msg) {
    var c = defaultConfig()
    return Config(c.url(), c.wordlist(), c.extensions(), c.threads(), c.timeoutSec(), c.retries(), c.output(), c.format(), c.headers(), c.cookie(), c.auth(), c.userAgent(), c.proxy(), c.domain(), c.resolver(), c.body(), c.method(), c.endpoint(), c.statusInclude(), c.excludeStatus(), c.excludeLength(), c.quiet(), c.color(), c.verbose(), false, false, msg, c.port())
}

// -- builders "with campo X" (records são imutáveis - cada um reconstrói) --

Config withUrl(Config c, String v) { return Config(v, c.wordlist(), c.extensions(), c.threads(), c.timeoutSec(), c.retries(), c.output(), c.format(), c.headers(), c.cookie(), c.auth(), c.userAgent(), c.proxy(), c.domain(), c.resolver(), c.body(), c.method(), c.endpoint(), c.statusInclude(), c.excludeStatus(), c.excludeLength(), c.quiet(), c.color(), c.verbose(), c.help(), c.valid(), c.errorMsg(), c.port()) }
Config withWordlist(Config c, String v) { return Config(c.url(), v, c.extensions(), c.threads(), c.timeoutSec(), c.retries(), c.output(), c.format(), c.headers(), c.cookie(), c.auth(), c.userAgent(), c.proxy(), c.domain(), c.resolver(), c.body(), c.method(), c.endpoint(), c.statusInclude(), c.excludeStatus(), c.excludeLength(), c.quiet(), c.color(), c.verbose(), c.help(), c.valid(), c.errorMsg(), c.port()) }
Config withExtensions(Config c, String v) { return Config(c.url(), c.wordlist(), v, c.threads(), c.timeoutSec(), c.retries(), c.output(), c.format(), c.headers(), c.cookie(), c.auth(), c.userAgent(), c.proxy(), c.domain(), c.resolver(), c.body(), c.method(), c.endpoint(), c.statusInclude(), c.excludeStatus(), c.excludeLength(), c.quiet(), c.color(), c.verbose(), c.help(), c.valid(), c.errorMsg(), c.port()) }
Config withThreads(Config c, Int v) { return Config(c.url(), c.wordlist(), c.extensions(), v, c.timeoutSec(), c.retries(), c.output(), c.format(), c.headers(), c.cookie(), c.auth(), c.userAgent(), c.proxy(), c.domain(), c.resolver(), c.body(), c.method(), c.endpoint(), c.statusInclude(), c.excludeStatus(), c.excludeLength(), c.quiet(), c.color(), c.verbose(), c.help(), c.valid(), c.errorMsg(), c.port()) }
Config withTimeout(Config c, Int v) { return Config(c.url(), c.wordlist(), c.extensions(), c.threads(), v, c.retries(), c.output(), c.format(), c.headers(), c.cookie(), c.auth(), c.userAgent(), c.proxy(), c.domain(), c.resolver(), c.body(), c.method(), c.endpoint(), c.statusInclude(), c.excludeStatus(), c.excludeLength(), c.quiet(), c.color(), c.verbose(), c.help(), c.valid(), c.errorMsg(), c.port()) }
Config withRetries(Config c, Int v) { return Config(c.url(), c.wordlist(), c.extensions(), c.threads(), c.timeoutSec(), v, c.output(), c.format(), c.headers(), c.cookie(), c.auth(), c.userAgent(), c.proxy(), c.domain(), c.resolver(), c.body(), c.method(), c.endpoint(), c.statusInclude(), c.excludeStatus(), c.excludeLength(), c.quiet(), c.color(), c.verbose(), c.help(), c.valid(), c.errorMsg(), c.port()) }
Config withOutput(Config c, String v) { return Config(c.url(), c.wordlist(), c.extensions(), c.threads(), c.timeoutSec(), c.retries(), v, c.format(), c.headers(), c.cookie(), c.auth(), c.userAgent(), c.proxy(), c.domain(), c.resolver(), c.body(), c.method(), c.endpoint(), c.statusInclude(), c.excludeStatus(), c.excludeLength(), c.quiet(), c.color(), c.verbose(), c.help(), c.valid(), c.errorMsg(), c.port()) }
Config withFormat(Config c, String v) { return Config(c.url(), c.wordlist(), c.extensions(), c.threads(), c.timeoutSec(), c.retries(), c.output(), v, c.headers(), c.cookie(), c.auth(), c.userAgent(), c.proxy(), c.domain(), c.resolver(), c.body(), c.method(), c.endpoint(), c.statusInclude(), c.excludeStatus(), c.excludeLength(), c.quiet(), c.color(), c.verbose(), c.help(), c.valid(), c.errorMsg(), c.port()) }
Config withCookie(Config c, String v) { return Config(c.url(), c.wordlist(), c.extensions(), c.threads(), c.timeoutSec(), c.retries(), c.output(), c.format(), c.headers(), v, c.auth(), c.userAgent(), c.proxy(), c.domain(), c.resolver(), c.body(), c.method(), c.endpoint(), c.statusInclude(), c.excludeStatus(), c.excludeLength(), c.quiet(), c.color(), c.verbose(), c.help(), c.valid(), c.errorMsg(), c.port()) }
Config withAuth(Config c, String v) { return Config(c.url(), c.wordlist(), c.extensions(), c.threads(), c.timeoutSec(), c.retries(), c.output(), c.format(), c.headers(), c.cookie(), v, c.userAgent(), c.proxy(), c.domain(), c.resolver(), c.body(), c.method(), c.endpoint(), c.statusInclude(), c.excludeStatus(), c.excludeLength(), c.quiet(), c.color(), c.verbose(), c.help(), c.valid(), c.errorMsg(), c.port()) }
Config withUserAgent(Config c, String v) { return Config(c.url(), c.wordlist(), c.extensions(), c.threads(), c.timeoutSec(), c.retries(), c.output(), c.format(), c.headers(), c.cookie(), c.auth(), v, c.proxy(), c.domain(), c.resolver(), c.body(), c.method(), c.endpoint(), c.statusInclude(), c.excludeStatus(), c.excludeLength(), c.quiet(), c.color(), c.verbose(), c.help(), c.valid(), c.errorMsg(), c.port()) }
