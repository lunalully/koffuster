Config withEndpoint(Config c, String v) { return Config(c.url(), c.wordlist(), c.extensions(), c.threads(), c.timeoutSec(), c.retries(), c.output(), c.format(), c.headers(), c.cookie(), c.auth(), c.userAgent(), c.proxy(), c.domain(), c.resolver(), c.body(), c.method(), v, c.statusInclude(), c.excludeStatus(), c.excludeLength(), c.quiet(), c.color(), c.verbose(), c.help(), c.valid(), c.errorMsg(), c.port()) }
