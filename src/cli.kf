Config withHeaderAdded(Config c, String v) {
    var newHeaders = listOf<String>()
    var i = 0
    while (i < c.headers().size()) {
        newHeaders.add(c.headers().get(i))
        i = i + 1
    }
    newHeaders.add(v)
    return Config(c.url(), c.wordlist(), c.extensions(), c.threads(), c.timeoutSec(), c.retries(), c.output(), c.format(), newHeaders, c.cookie(), c.auth(), c.userAgent(), c.proxy(), c.domain(), c.resolver(), c.body(), c.method(), c.endpoint(), c.statusInclude(), c.excludeStatus(), c.excludeLength(), c.quiet(), c.color(), c.verbose(), c.help(), c.valid(), c.errorMsg(), c.port())
}

// -- redação de segredos --------------------------------------------------

String redactedAuth(String auth) {
    if (auth.length() == 0) { return "" }
    return "<redacted>"
}
String redactedCookie(String cookie) {
    if (cookie.length() == 0) { return "" }
    return "<redacted>"
}

String configEcho(Config c) {
    var s = "config: url=" + redactUrl(c.url())
    s = s + " wordlist=" + c.wordlist()
    s = s + " extensions=" + c.extensions()
    s = s + " threads=" + c.threads()
    s = s + " timeout=" + c.timeoutSec() + "s"
    s = s + " format=" + c.format()
    s = s + " status=" + c.statusInclude()
    s = s + " excludeStatus=" + c.excludeStatus()
    s = s + " userAgent=" + c.userAgent()
    if (c.cookie().length() > 0) { s = s + " cookie=" + redactedCookie(c.cookie()) }
    if (c.auth().length() > 0) { s = s + " auth=" + redactedAuth(c.auth()) }
    return s
}

// -- textos de ajuda ------------------------------------------------------

String commonOptionsHelp() {
    var h = "Comuns:\n"
    h = h + "  -w, --wordlist <arquivo|->   wordlist (ou - para stdin)\n"
    h = h + "  -t, --threads <n>            concorrência (padrão 8)\n"
    h = h + "      --timeout <seg>          timeout por request (padrão 10)\n"
    h = h + "  -o, --output <arquivo>       grava resultados também no arquivo\n"
    h = h + "  -f, --format <text|jsonl>    formato de saída (padrão text)\n"
    h = h + "      --proxy <url>            proxy HTTP (launcher mapeia p/ JVM)\n"
    h = h + "  -q, --quiet, -silent         sem banner/progresso/resumo, só resultados\n"
    h = h + "      --color                  força cores ANSI\n"
    h = h + "  -v, --verbose                mostra a config efetiva (segredos ocultos)\n"
    h = h + "  -h, --help                   esta ajuda\n"
    return h
}

String authOptionsHelp() {
    var h = "  -H, --header <'Chave: Valor'> header extra, repetível\n"
    h = h + "      --cookie <c>             cookie (oculto no -v)\n"
    h = h + "      --auth <user:pass>       Basic Auth (oculto no -v)\n"
    h = h + "  -a, --user-agent <ua>        User-Agent (padrão koffuster/0.2)\n"
    return h
}

String exitCodesHelp() {
    var h = "\nCódigos de saída: 0 ok (inclusive uma execução limpa sem achados);\n"
    h = h + "1 execução com zero resultados E pelo menos um erro operacional;\n"
    h = h + "2 erro de uso.\n"
    return h
}

String dirHelpText() {
    var h = "koffuster dir - força bruta de diretórios/arquivos\n\n"
    h = h + "Uso: koffuster dir <url> <wordlist|-> [opções]\n"
    h = h + "     (forma clássica: koffuster dir -u <url> -w <wordlist|->)\n\n"
    h = h + "Sem esquema na url, assume https:// (para http://, digite o esquema).\n\n"
    h = h + "Obrigatório:\n"
    h = h + "  <url>                        URL base; -u, --url também aceita\n"
    h = h + "                               (path/query preservados)\n"
    h = h + "  <wordlist|->                 wordlist; -w, --wordlist também aceita\n"
    h = h + "                               (ou - para stdin)\n\n"
    h = h + "Específicas:\n"
    h = h + "  -x, --extensions <csv>       extensões extras por palavra (php,html)\n"
    h = h + "  -s, --status <lista>         só status listados; desliga exclusão de 404\n"
    h = h + "  -b, --exclude-status <lista> exclui status (aplicado após -s)\n"
    h = h + "      --exclude-length <lista> exclui por tamanho do corpo (0,100-200)\n\n"
    h = h + authOptionsHelp()
    h = h + "\n"
    h = h + commonOptionsHelp()
    h = h + "\nPrecedência dos filtros: -s (se dado) desliga a exclusão padrão de 404;\n"
    h = h + "-b aplica depois; --exclude-length por último.\n"
    h = h + exitCodesHelp()
    h = h + "\nExemplos:\n"
    h = h + "  koffuster dir alvo.com.br words.txt\n"
    h = h + "  koffuster dir http://alvo/app/ words.txt -x php,html -t 16 -s 200,301\n"
    h = h + "  cat words.txt | koffuster dir alvo.com.br -\n"
    h = h + "  koffuster dir alvo.com.br words.txt -o hits.jsonl -f jsonl -q\n"
    return h
}

String dnsHelpText() {
    var h = "koffuster dns - enumeração de subdomínios via DNS-over-HTTPS\n\n"
    h = h + "Uso: koffuster dns <domínio> <wordlist|-> [opções]\n"
    h = h + "     (forma clássica: koffuster dns -d <domínio> -w <wordlist|->)\n\n"
    h = h + "Obrigatório:\n"
    h = h + "  <domínio>                    domínio base; -d, --domain também aceita\n"
    h = h + "                               (candidatos viram palavra.domínio)\n"
    h = h + "  <wordlist|->                 wordlist; -w, --wordlist também aceita\n"
    h = h + "                               (ou - para stdin)\n\n"
    h = h + "Específicas:\n"
    h = h + "      --resolver <url>        endpoint DoH JSON (padrão dns.google)\n\n"
    h = h + commonOptionsHelp()
    h = h + "\nResultados: resolved (Status 0), nxdomain (3), resolver_down, timeout.\n"
    h = h + "Um resolver DoH responde HTTP 200 até para NXDOMAIN - a distinção vem do\n"
    h = h + "campo JSON Status, não do HTTP. Probes de wildcard (3 nomes aleatórios)\n"
    h = h + "rodam antes; candidatos que resolverem para o mesmo IP do wildcard são\n"
    h = h + "descartados.\n"
    h = h + exitCodesHelp()
    h = h + "\nExemplos:\n"
    h = h + "  koffuster dns exemplo.com subs.txt\n"
    h = h + "  koffuster dns exemplo.com subs.txt -f jsonl -o found.jsonl\n"
    return h
}

String vhostHelpText() {
    var h = "koffuster vhost - enumeração de virtual hosts via header Host\n\n"
    h = h + "Uso: koffuster vhost <url> <wordlist|-> [opções]\n"
    h = h + "     (forma clássica: koffuster vhost -u <url> -w <wordlist|->)\n\n"
    h = h + "Sem esquema na url, assume https:// (para http://, digite o esquema).\n\n"
    h = h + "Obrigatório:\n"
    h = h + "  <url>                        URL fixa; -u, --url também aceita\n"
    h = h + "                               (o Host é o que varia)\n"
    h = h + "  <wordlist|->                 wordlist; -w, --wordlist também aceita\n"
    h = h + "                               (ou - para stdin)\n\n"
    h = h + "Específicas:\n"
    h = h + "  -d, --domain <domínio>       Host vira palavra.domínio (se dado)\n\n"
    h = h + authOptionsHelp()
    h = h + "\n"
    h = h + commonOptionsHelp()
    h = h + "\nO header Host exige -Djdk.httpclient.allowRestrictedHeaders=host (o launcher\n"
    h = h + "já exporta). Hit = candidato cujo status ou tamanho do corpo difere do\n"
    h = h + "baseline (Hosts aleatórios). Com headers custom, o status exato só sai\n"
    h = h + "para 5xx (via exceção do runtime); o resto reporta tamanho do corpo.\n"
    h = h + exitCodesHelp()
    h = h + "\nExemplos:\n"
    h = h + "  koffuster vhost http://10.0.0.5/ hosts.txt --domain exemplo.com\n"
    h = h + "  koffuster vhost http://10.0.0.5/ hosts.txt -f jsonl\n"
    return h
}

String fuzzHelpText() {
    var h = "koffuster fuzz - substituição de FUZZ em URL/cabeçalho/corpo\n\n"
    h = h + "Uso: koffuster fuzz <url-com-FUZZ> <wordlist|-> [opções]\n"
    h = h + "     (forma clássica: koffuster fuzz -u <url> -w <wordlist|->)\n\n"
    h = h + "Obrigatório:\n"
    h = h + "  <url>                        URL com FUZZ; -u, --url também aceita\n"
    h = h + "                               (FUZZ pode aparecer aqui, em -H ou --body)\n"
    h = h + "  <wordlist|->                 wordlist; -w, --wordlist também aceita\n"
    h = h + "                               (ou - para stdin; erro se FUZZ não aparecer)\n\n"
    h = h + "Específicas:\n"
    h = h + "  -X, --method <verbo>        GET (padrão), POST, PUT ou DELETE\n"
    h = h + "      --body <dados>          corpo do POST/PUT; pode conter FUZZ\n"
    h = h + "  -s, --status <lista>        só status listados; desliga exclusão de 404\n"
    h = h + "  -b, --exclude-status <lista> exclui status\n"
    h = h + "      --exclude-length <lista> exclui por tamanho do corpo\n\n"
    h = h + authOptionsHelp()
    h = h + "\n"
    h = h + commonOptionsHelp()
    h = h + "\nCodificação: FUZZ na URL é percent-encoded; em header/corpo é substituído\n"
    h = h + "cru. Toda ocorrência de FUZZ (url+headers+body) recebe a mesma palavra.\n"
    h = h + exitCodesHelp()
    h = h + "\nExemplos:\n"
    h = h + "  koffuster fuzz \"alvo.com/busca?q=FUZZ\" payloads.txt -s 200\n"
    h = h + "  koffuster fuzz alvo.com/api users.txt -X POST --body \"user=FUZZ\"\n"
    h = h + "  koffuster fuzz alvo.com tokens.txt -H \"X-Token: FUZZ\"\n"
    return h
}

String storeHelpText(String modeName, String defaultEndpoint) {
    var h = "koffuster " + modeName + " - checagem de bucket (somente leitura)\n\n"
    h = h + "Uso: koffuster " + modeName + " <wordlist|-> [opções]\n"
    h = h + "     (forma clássica: koffuster " + modeName + " -w <wordlist|->)\n\n"
    h = h + "Obrigatório:\n"
    h = h + "  <wordlist|->                 nomes de bucket; -w, --wordlist também\n"
    h = h + "                               aceita (ou - para stdin)\n\n"
    h = h + "Específicas:\n"
    h = h + "      --endpoint <modelo>     %s vira o nome do bucket\n"
    h = h + "                              (padrão " + defaultEndpoint + ")\n\n"
    h = h + commonOptionsHelp()
    h = h + "\nSó GET/status - nunca escreve. Mapeamento: 404 ausente, 403\n"
    h = h + "exists_denied (nunca tratado como ausente), 200 público, resto ou erro\n"
    h = h + "de conexão inconclusivo.\n"
    h = h + exitCodesHelp()
    h = h + "\nExemplos:\n"
    h = h + "  koffuster " + modeName + " buckets.txt\n"
    h = h + "  koffuster " + modeName + " buckets.txt --endpoint 'http://127.0.0.1:8080/b/%s' -f jsonl\n"
    return h
}

String tftpHelpText() {
    var h = "koffuster tftp - checagem de existência de arquivo TFTP (RRQ, somente leitura)\n\n"
    h = h + "Uso: koffuster tftp <servidor[:porta]> <wordlist|-> [opções]\n"
    h = h + "     (forma clássica: koffuster tftp -u <host[:porta]> -w <wordlist|->)\n\n"
    h = h + "Obrigatório:\n"
    h = h + "  <servidor[:porta]>           host TFTP; a porta pode vir embutida\n"
    h = h + "  <wordlist|->                 nomes de arquivo; -w, --wordlist também\n"
    h = h + "                               aceita (ou - para stdin)\n\n"
    h = h + "Específicas:\n"
    h = h + "      --port <n>              porta TFTP quando não vem no servidor\n"
    h = h + "                              (padrão 69)\n\n"
    h = h + commonOptionsHelp()
    h = h + "\nComo funciona: um RRQ (modo octet) por candidato; DATA = existe; ERROR 2\n"
    h = h + "(access violation) = existe com acesso negado; ERROR 1 = não existe\n"
    h = h + "(omitido por padrão; -v mostra). Sem resposta = timeout (omitido por\n"
    h = h + "padrão; -v mostra e conta como erro). Ao receber DATA, o ACK do bloco 1\n"
    h = h + "é enviado para o servidor parar de retransmitir.\n"
    h = h + exitCodesHelp()
    h = h + "\nExemplos:\n"
    h = h + "  koffuster tftp 10.0.0.9 arquivos.txt\n"
    h = h + "  koffuster tftp 10.0.0.9:6969 arquivos.txt -v\n"
    h = h + "  koffuster tftp 10.0.0.9 arquivos.txt --port 6969 -f jsonl -o found.jsonl\n"
    return h
}