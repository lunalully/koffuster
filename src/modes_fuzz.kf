// modes_fuzz.kf - o driver do modo `fuzz`: substitui cada ocorrência de
// FUZZ (na URL, em -H, ou em --body) por cada palavra da wordlist.

import kof.process

Bool runFuzzMode(String[] args) {
    var cfg = parseModeArgs(args, 1, "fuzz")

    if (cfg.help()) {
        println(fuzzHelpText())
        return true
    }
    if (cfg.valid() == false) {
        log.error("koffuster fuzz: " + cfg.errorMsg())
        process.exit(2)
        return false
    }

    var fuzzInUrl = cfg.url().contains("FUZZ")
    var fuzzInBody = cfg.body().contains("FUZZ")
    var fuzzInHeader = false
    var hi = 0
    while (hi < cfg.headers().size()) {
        if (cfg.headers().get(hi).contains("FUZZ")) { fuzzInHeader = true }
        hi = hi + 1
    }
    if (fuzzInUrl == false && fuzzInBody == false && fuzzInHeader == false) {
        log.error("koffuster fuzz: FUZZ não encontrado em -u/-H/--body - nada para substituir (veja: koffuster help fuzz)")
        process.exit(2)
        return false
    }

    var method = cfg.method()
    if (method.length() == 0) { method = "GET" }

    var noColorEnv = envIsSet("NO_COLOR")
    var colorOn = colorsEnabled(cfg.color(), false, cfg.quiet(), cfg.format(), noColorEnv)
    printBanner(cfg.quiet(), false, cfg.format())
    if (cfg.verbose()) {
        log.error(configEcho(cfg))
        log.error("koffuster fuzz: method=" + method + " fuzzInUrl=" + fuzzInUrl + " fuzzInHeader=" + fuzzInHeader + " fuzzInBody=" + fuzzInBody)
    }

    http.timeout(cfg.timeoutSec())
    var startMs = time.now()

    var words = loadWordlist(cfg.wordlist())
    if (cfg.quiet() == false) {
        log.error("koffuster fuzz: " + words.size() + " candidatos")
    }

    var authHeader = ""
    if (cfg.auth().length() > 0) {
        authHeader = "Basic " + base64Encode(cfg.auth())
    }
    var baseHeaders = buildHeaders(cfg.userAgent(), cfg.headers(), cfg.cookie(), authHeader)

    // Caminho simples: GET, FUZZ só na URL, sem headers/cookie/auth custom
    // -> usa http.status (status exato para qualquer resposta).
    var simplePath = method == "GET" && fuzzInHeader == false && fuzzInBody == false && cfg.headers().size() == 0 && cfg.cookie().length() == 0 && cfg.auth().length() == 0
    var useHeaders = simplePath == false

    var width = snapThreads(cfg.threads())
    var totalOps = 0
    var foundCount = 0
    var errorCount = 0
    var held = listOf<String>()
    var showProgress = (cfg.quiet() == false && words.size() >= 50)
    var lastBucket = -1

    var total = words.size()
    if (showProgress) {
        lastBucket = tickProgress(0, total, 0, lastBucket)
    }
    var idx = 0
    while (idx < total) {
        var count = width
        if (idx + count > total) { count = total - idx }

        var batchWords = listOf<String>()
        var batchUrls = listOf<String>()
        var batchHdrs = listOf<String>()
        var batchBodies = listOf<String>()
        var j = 0
        while (j < count) {
            var word = words.get(idx + j)
            var fuzzedUrl = fuzzSubstituteUrl(cfg.url(), word)
            batchWords.add(word)
            batchUrls.add(fuzzedUrl)
            batchHdrs.add(fuzzBuildHeaders(baseHeaders, word))
            batchBodies.add(fuzzSubstituteRaw(cfg.body(), word))
            j = j + 1
        }

        var results = listOf<String>()
        if (simplePath) {
            results = runStatusBatch(width, batchUrls, count)
        } else if (method == "POST" || method == "PUT") {
            results = runVerbBatch(width, method, batchUrls, batchBodies, batchHdrs.get(0), count)
        } else if (method == "DELETE") {
            results = runVerbBatch(width, "DELETE", batchUrls, batchBodies, batchHdrs.get(0), count)
        } else {
            results = runVhostBatch(width, batchUrls, batchHdrs, count)
        }
        totalOps = totalOps + count

        var m = 0
        while (m < count) {
            var raw = results.get(m)
            var url = batchUrls.get(m)
            if (raw.startsWith("ERR:")) {
                var err = raw.substring(4)
                if (err.startsWith("http")) {
                    errorCount = errorCount + 1
                    if (cfg.verbose()) { log.error("erro: " + redactUrl(url) + " -> HTTP " + err.substring(4)) }
                } else {
                    errorCount = errorCount + 1
                    if (cfg.verbose()) { log.error("erro: " + redactUrl(url) + " -> " + err) }
                }
            } else {
                var status = -1
                var length = "-"
                if (simplePath) {
                    status = raw.toInt()
                    var noBaseline2 = Baseline(false, 0, -1)
                    var pre = decideResult(status, -1, noBaseline2, cfg.statusInclude(), cfg.excludeStatus(), cfg.excludeLength())
                    if (pre.startsWith("include")) {
                        var lraw = bodyOnceWithRetries(url, "", false, cfg.retries())
                        if (lraw.startsWith("ERR:") == false) {
                            length = "" + lraw.length()
                        }
                    }
                } else {
                    status = 200
                    length = "" + raw.length()
                }
                var noBaseline = Baseline(false, 0, -1)
                var decision = decideResult(status, toIntOr(length, -1), noBaseline, cfg.statusInclude(), cfg.excludeStatus(), cfg.excludeLength())
                if (decision.startsWith("include")) {
                    foundCount = foundCount + 1
                    var result = FuzzResult(url, status, length, batchWords.get(m))
                    emitFuzzResult(result, cfg, colorOn, held)
                }
            }
            m = m + 1
        }

        idx = idx + count
        if (showProgress) {
            lastBucket = tickProgress(idx, total, foundCount, lastBucket)
        }
    }

    if (showProgress) {
        lastBucket = tickProgress(total, total, foundCount, lastBucket)
    }
    flushHeldResults(held)

    var durationMs = time.now() - startMs
    printSummary(cfg.quiet(), totalOps, foundCount, errorCount, durationMs)
    exitOnTotalFailure(foundCount, errorCount)
    return true
}

// FUZZ na URL é percent-encoded por palavra; em header/corpo é cru.
String fuzzSubstituteUrl(String url, String word) {
    return url.replace("FUZZ", percentEncode(word))
}
String fuzzSubstituteRaw(String s, String word) {
    return s.replace("FUZZ", word)
}
// baseHeaders já contém UA + -H + cookie + auth (sem FUZZ); os headers com
// FUZZ precisam da substituição na string final.
String fuzzBuildHeaders(String baseHeaders, String word) {
    return baseHeaders.replace("FUZZ", word)
}

Bool emitFuzzResult(FuzzResult r, Config cfg, Bool colorOn, List<String> held) {
    var line = ""
    if (cfg.format() == "jsonl") {
        line = formatFuzzJsonl(r)
    } else {
        line = formatFuzzText(r, colorOn, true)
    }
    held.add(line)
    if (cfg.output().length() > 0) {
        var fileLine = line
        if (cfg.format() != "jsonl") { fileLine = formatFuzzText(r, false, true) }
        appendResultLine(cfg.output(), fileLine)
    }
    return true
}