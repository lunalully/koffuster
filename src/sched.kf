// -- headerless body-length probes (1-arg http.get) ----------------------
// The ONE-argument `http.get(url)` does NOT throw on 4xx (confirmed
// directly - see docs/impl-notes.md's correction to cookbook P1a), so
// whenever a run has no custom headers/cookie/auth to send, these slots
// recover a real body length for every 2xx/3xx/4xx candidate instead of
// just 2xx (which is all the header-bearing bodySlotN above can manage).
// 5xx still throws even through this one-argument form (also reconfirmed
// directly) and correctly falls back to the "-" sentinel either way.
Int bodyNoHdrSlot0() { return http.get(Path(slotBodyPath(0)).readText()).length() }
Int bodyNoHdrSlot1() { return http.get(Path(slotBodyPath(1)).readText()).length() }
Int bodyNoHdrSlot2() { return http.get(Path(slotBodyPath(2)).readText()).length() }
Int bodyNoHdrSlot3() { return http.get(Path(slotBodyPath(3)).readText()).length() }
Int bodyNoHdrSlot4() { return http.get(Path(slotBodyPath(4)).readText()).length() }
Int bodyNoHdrSlot5() { return http.get(Path(slotBodyPath(5)).readText()).length() }
Int bodyNoHdrSlot6() { return http.get(Path(slotBodyPath(6)).readText()).length() }
Int bodyNoHdrSlot7() { return http.get(Path(slotBodyPath(7)).readText()).length() }
Int bodyNoHdrSlot8() { return http.get(Path(slotBodyPath(8)).readText()).length() }
Int bodyNoHdrSlot9() { return http.get(Path(slotBodyPath(9)).readText()).length() }
Int bodyNoHdrSlot10() { return http.get(Path(slotBodyPath(10)).readText()).length() }
Int bodyNoHdrSlot11() { return http.get(Path(slotBodyPath(11)).readText()).length() }
Int bodyNoHdrSlot12() { return http.get(Path(slotBodyPath(12)).readText()).length() }
Int bodyNoHdrSlot13() { return http.get(Path(slotBodyPath(13)).readText()).length() }
Int bodyNoHdrSlot14() { return http.get(Path(slotBodyPath(14)).readText()).length() }
Int bodyNoHdrSlot15() { return http.get(Path(slotBodyPath(15)).readText()).length() }

// -- per-slot HEADERS override (vhost/fuzz need a different header string
// per candidate - e.g. vhost's varying Host header) -----------------------
String slotHeadersPath(Int slot) {
    return "/tmp/.koffuster_slot_hdrs_" + slot + ".txt"
}
// Body-length probe that reads its headers from its OWN per-slot file
// rather than the single shared run-wide headersFilePath() - used by
// vhost/fuzz, which write a different header string per candidate before
// spawning each slot. dir mode still works unchanged: it just writes the
// same shared header string into every slot's per-slot file each batch.
Int bodyPerSlotHdr0() { return http.get(Path(slotBodyPath(0)).readText(), Path(slotHeadersPath(0)).readText()).length() }
Int bodyPerSlotHdr1() { return http.get(Path(slotBodyPath(1)).readText(), Path(slotHeadersPath(1)).readText()).length() }
Int bodyPerSlotHdr2() { return http.get(Path(slotBodyPath(2)).readText(), Path(slotHeadersPath(2)).readText()).length() }
Int bodyPerSlotHdr3() { return http.get(Path(slotBodyPath(3)).readText(), Path(slotHeadersPath(3)).readText()).length() }
Int bodyPerSlotHdr4() { return http.get(Path(slotBodyPath(4)).readText(), Path(slotHeadersPath(4)).readText()).length() }
Int bodyPerSlotHdr5() { return http.get(Path(slotBodyPath(5)).readText(), Path(slotHeadersPath(5)).readText()).length() }
Int bodyPerSlotHdr6() { return http.get(Path(slotBodyPath(6)).readText(), Path(slotHeadersPath(6)).readText()).length() }
Int bodyPerSlotHdr7() { return http.get(Path(slotBodyPath(7)).readText(), Path(slotHeadersPath(7)).readText()).length() }

