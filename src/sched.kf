// sched.kf - concorrência para Koffuster (KOF 0.5.0-beta).
//
// No 0.2.6-beta, dois bloqueios do compilador forçavam 16 slots unrolled por
// família de probe (spawn só aceitava funções sem argumentos e
// listOf<Handle<T>>() morria no verificador de bytecode). O 0.5.0-beta
// corrigiu os dois: `spawn f(x)` aceita argumentos dinâmicos e
// `listOf<Handle<T>>()` + `await` funciona normalmente. Este arquivo inteiro
// é a substituição do antigo sched.kf de ~1200 linhas: um punhado de
// funções genéricas com spawn dinâmico.

import kof.process

// Classe de erro HTTP estável a partir da exceção capturada.
// No 0.5.0 o catch recebe `Exception` (não String), e o runtime lança
// IOException com "HTTP <code> from <url>" apenas para 5xx (4xx retorna
// corpo normalmente via http.get).
String classifyHttpErr(Exception e) {
    var msg = "" + e
    if (msg.contains("ConnectException")) { return "refused" }
    if (msg.contains("HttpTimeoutException")) { return "timeout" }
    if (msg.contains("UnknownHostException")) { return "dns_error" }
    if (msg.contains("HTTP 5")) { return "http5xx" }
    return "error"
}

// Extrai o status HTTP de uma exceção do runtime ("HTTP 500 from <url>").
// Retorna -1 se não houver status embutido na mensagem.
Int statusFromException(Exception e) {
    var msg = "" + e
    var key = "HTTP "
    var i = msg.indexOf(key)
    if (i < 0) { return -1 }
    var code = msg.substring(i + key.length())
    var j = 0
    while (j < code.length()) {
        var ch = code.charAt(j)
        if (ch < 48 || ch > 57) {
            code = code.substring(0, j)
            j = code.length()
        } else {
            j = j + 1
        }
    }
    return toIntOr(code, -1)
}

// -- probes individuais (cada uma é um alvo de spawn dinâmico) ------------

// Status exato para QUALQUER resposta HTTP (2xx/3xx/4xx/5xx): http.status
// não lança por status code nesta build. Só lança por erro de rede.
String statusOne(String url) {
    try {
        return "" + http.status(url)
    } catch (Exception e) {
        return "ERR:" + classifyHttpErr(e)
    }
}

// Corpo com headers custom. 2xx/3xx/4xx retornam o corpo; 5xx lança
// IOException ("HTTP <code> from <url>") - classificada como http5xx com o
// status extraído. Usada por vhost (Host custom) e por dir/fuzz quando o
// usuário passa -H/--cookie/--auth.
String bodyWithHeaders(String url, String hdrs) {
    try {
        return http.get(url, hdrs)
    } catch (Exception e) {
        var st = statusFromException(e)
        if (st > 0) { return "ERR:http" + st }
        return "ERR:" + classifyHttpErr(e)
    }
}

// Corpo sem headers (1-arg http.get). Retorna o corpo para 2xx-4xx; 5xx
// também lança aqui (mesmo caminho do runtime).
String bodyPlain(String url) {
    try {
        return http.get(url)
    } catch (Exception e) {
        var st = statusFromException(e)
        if (st > 0) { return "ERR:http" + st }
        return "ERR:" + classifyHttpErr(e)
    }
}

// Corpo via POST/PUT/DELETE (fuzz com método custom).
String bodyPost(String url, String body, String hdrs) {
    try {
        return http.post(url, body, hdrs)
    } catch (Exception e) {
        var st = statusFromException(e)
        if (st > 0) { return "ERR:http" + st }
        return "ERR:" + classifyHttpErr(e)
    }
}
String bodyPut(String url, String body, String hdrs) {
    try {
        return http.put(url, body, hdrs)
    } catch (Exception e) {
        var st = statusFromException(e)
        if (st > 0) { return "ERR:http" + st }
        return "ERR:" + classifyHttpErr(e)
    }
}
String bodyDelete(String url, String hdrs) {
    try {
        return http.delete(url, hdrs)
    } catch (Exception e) {
        var st = statusFromException(e)
        if (st > 0) { return "ERR:http" + st }
        return "ERR:" + classifyHttpErr(e)
    }
}

// -- batches com spawn dinâmico ------------------------------------------

// Spawna `fn(url)` para cada url e aguarda todos, na ordem.
// `width` limita a concorrência: os primeiros `width` candidatos são
// spawnados, aguardados, e o próximo lote começa.
List<String> runStatusBatch(Int width, List<String> urls, Int count) {
    var out = listOf<String>()
    var i = 0
    while (i < count) {
        var batch = listOf<Handle<String>>()
        var end = i + width
        if (end > count) { end = count }
        var j = i
        while (j < end) {
            batch.add(spawn statusOne(urls.get(j)))
            j = j + 1
        }
        for (var h in batch) {
            out.add(await h)
        }
        i = end
    }
    return out
}

List<String> runBodyBatch(Int width, List<String> urls, String hdrs, Bool useHeaders, Int count) {
    var out = listOf<String>()
    var i = 0
    while (i < count) {
        var batch = listOf<Handle<String>>()
        var end = i + width
        if (end > count) { end = count }
        var j = i
        while (j < end) {
            if (useHeaders) {
                batch.add(spawn bodyWithHeaders(urls.get(j), hdrs))
            } else {
                batch.add(spawn bodyPlain(urls.get(j)))
            }
            j = j + 1
        }
        for (var h in batch) {
            out.add(await h)
        }
        i = end
    }
    return out
}

List<String> runVerbBatch(Int width, String verb, List<String> urls, List<String> bodies, String hdrs, Int count) {
    var out = listOf<String>()
    var i = 0
    while (i < count) {
        var batch = listOf<Handle<String>>()
        var end = i + width
        if (end > count) { end = count }
        var j = i
        while (j < end) {
            if (verb == "POST") {
                batch.add(spawn bodyPost(urls.get(j), bodies.get(j), hdrs))
            } else if (verb == "PUT") {
                batch.add(spawn bodyPut(urls.get(j), bodies.get(j), hdrs))
            } else {
                batch.add(spawn bodyDelete(urls.get(j), hdrs))
            }
            j = j + 1
        }
        for (var h in batch) {
            out.add(await h)
        }
        i = end
    }
    return out
}

// vhost: cada candidato tem seu próprio header string (Host varia), então
// o batch recebe uma lista de headers alinhada com as urls.
List<String> runVhostBatch(Int width, List<String> urls, List<String> hdrsList, Int count) {
    var out = listOf<String>()
    var i = 0
    while (i < count) {
        var batch = listOf<Handle<String>>()
        var end = i + width
        if (end > count) { end = count }
        var j = i
        while (j < end) {
            batch.add(spawn bodyWithHeaders(urls.get(j), hdrsList.get(j)))
            j = j + 1
        }
        for (var h in batch) {
            out.add(await h)
        }
        i = end
    }
    return out
}

// Length sentinel: transforma "ERR:*" no display "-" (nunca -1, que parece
// um length real negativo).
String lenOrDash(String raw) {
    if (raw.startsWith("ERR:")) { return "-" }
    return "" + raw.length()
}

// Snap de concorrência: agora aceita QUALQUER Int >= 1 (spawn dinâmico não
// tem mais a trava de 1/2/4/8/16 do 0.2.6).
Int snapThreads(Int t) {
    if (t < 1) { return 1 }
    return t
}

// Retry simples para probes individuais (controle/baseline e candidatos
// com erro de rede). Nunca repete 5xx (não é idempotente com sentido aqui).
String statusWithRetries(String url, Int maxRetries) {
    var result = statusOne(url)
    var attempt = 0
    while (result.startsWith("ERR:") && isRetryable(result) && attempt < maxRetries) {
        time.sleep(200 + (attempt * 300))
        result = statusOne(url)
        attempt = attempt + 1
    }
    return result
}

String bodyOnceWithRetries(String url, String hdrs, Bool useHeaders, Int maxRetries) {
    var result = ""
    if (useHeaders) {
        result = bodyWithHeaders(url, hdrs)
    } else {
        result = bodyPlain(url)
    }
    var attempt = 0
    while (result.startsWith("ERR:") && isRetryable(result) && attempt < maxRetries) {
        time.sleep(200 + (attempt * 300))
        if (useHeaders) {
            result = bodyWithHeaders(url, hdrs)
        } else {
            result = bodyPlain(url)
        }
        attempt = attempt + 1
    }
    return result
}

Bool isRetryable(String result) {
    if (result.contains("refused")) { return true }
    if (result.contains("timeout")) { return true }
    if (result.contains("dns_error")) { return true }
    return false
}