// -- raw-body-TEXT probes (dns mode needs the actual JSON, not a length) --
// Uses the shared headersFilePath() (dns writes a constant
// "Accept: application/dns-json" header once at startup - every DoH query
// sends the same header, unlike vhost/fuzz's per-candidate headers).
String bodyTextSlot0() { return http.get(Path(slotBodyPath(0)).readText(), Path(headersFilePath()).readText()) }
String bodyTextSlot1() { return http.get(Path(slotBodyPath(1)).readText(), Path(headersFilePath()).readText()) }
String bodyTextSlot2() { return http.get(Path(slotBodyPath(2)).readText(), Path(headersFilePath()).readText()) }
String bodyTextSlot3() { return http.get(Path(slotBodyPath(3)).readText(), Path(headersFilePath()).readText()) }
String bodyTextSlot4() { return http.get(Path(slotBodyPath(4)).readText(), Path(headersFilePath()).readText()) }
String bodyTextSlot5() { return http.get(Path(slotBodyPath(5)).readText(), Path(headersFilePath()).readText()) }
String bodyTextSlot6() { return http.get(Path(slotBodyPath(6)).readText(), Path(headersFilePath()).readText()) }
String bodyTextSlot7() { return http.get(Path(slotBodyPath(7)).readText(), Path(headersFilePath()).readText()) }
String bodyTextSlot8() { return http.get(Path(slotBodyPath(8)).readText(), Path(headersFilePath()).readText()) }
String bodyTextSlot9() { return http.get(Path(slotBodyPath(9)).readText(), Path(headersFilePath()).readText()) }
String bodyTextSlot10() { return http.get(Path(slotBodyPath(10)).readText(), Path(headersFilePath()).readText()) }
String bodyTextSlot11() { return http.get(Path(slotBodyPath(11)).readText(), Path(headersFilePath()).readText()) }
String bodyTextSlot12() { return http.get(Path(slotBodyPath(12)).readText(), Path(headersFilePath()).readText()) }
String bodyTextSlot13() { return http.get(Path(slotBodyPath(13)).readText(), Path(headersFilePath()).readText()) }
String bodyTextSlot14() { return http.get(Path(slotBodyPath(14)).readText(), Path(headersFilePath()).readText()) }
String bodyTextSlot15() { return http.get(Path(slotBodyPath(15)).readText(), Path(headersFilePath()).readText()) }

// Length sentinel: batch functions already return "ERR:reason" strings for
// a failed probe; this turns any such value into the single display
// sentinel "-" (never the misleading "-1", which looks like a real
// negative length) for both text and JSONL output. A String field (not
// Int) is what lets JSONL show "-" too - see output.kf's *Result records.
String lenOrDash(String raw) {
    if (raw.startsWith("ERR:")) { return "-" }
    return raw
}

// Snap a requested thread count DOWN to the nearest supported unrolled
// width - used for --threads, where rounding down just means "a bit less
// parallelism than asked for", never a correctness issue.
Int snapThreads(Int t) {
    if (t <= 1) { return 1 }
    if (t <= 3) { return 2 }
    if (t <= 6) { return 4 }
    if (t <= 12) { return 8 }
    return 16
}

// Smaller cap (1/2/4/8) for the newer per-slot-header/post/put/delete/
// DoH-query batch families below (vhost/fuzz/dns/s3/gcs) - keeps the
// amount of generated slot-function/temp-file code proportionate; dir
// mode is the only one that needs the full 16-wide family.
Int snapThreads8(Int t) {
    if (t <= 1) { return 1 }
    if (t <= 3) { return 2 }
    if (t <= 6) { return 4 }
    return 8
}
Int widthForCount8(Int n) {
    if (n <= 1) { return 1 }
    if (n <= 2) { return 2 }
    if (n <= 4) { return 4 }
    return 8
}

// Rounds a REQUIRED item count UP to the nearest supported unrolled width
// - used when sizing a batch that must fit `n` real candidates (e.g. the
// body-length sub-batch): unlike snapThreads, this must never return a
// width smaller than `n`, or candidates past the width would silently be
// dropped from the batch's result list. Always <= 16 in practice here,
// since callers only ever pass a subset of an already-<=16-wide main
// batch.
Int widthForCount(Int n) {
    if (n <= 1) { return 1 }
    if (n <= 2) { return 2 }
    if (n <= 4) { return 4 }
    if (n <= 8) { return 8 }
    return 16
}

// Run one batch of up to `width` status probes (width must be a supported
// snap value; `count` <= width is how many of the batch's slots are real
// candidates - the rest are left unspawned). `urls` holds the batch's
// candidate URLs at indices [0, count). Results land in `outStatus`/
// `outOk`/`outErr`, pre-sized to `width` by the caller (only the first
// `count` entries are meaningful).
//
// This function itself takes ordinary parameters (listOf<...>, Int) - that
// is fine, the spawn-argument bug only affects the literal arguments of a
// `spawn` expression, not normal function calls.
List<String> runStatusBatch(Int width, List<String> urls, Int count) {
    // Write every slot's URL file synchronously (plain writeText, not
    // spawned) before spawning any request in this batch - this is what
    // makes the batch race-free.
    var i = 0
    while (i < count) {
        Path(slotStatusPath(i)).writeText(urls.get(i))
        i = i + 1
    }
    // Clear any unused tail slots left over from a wider previous batch so
    // they fail fast on a missing file instead of silently re-probing a
    // stale real target from an earlier batch.
    while (i < width) {
        var stale = Path(slotStatusPath(i))
        if (stale.exists()) { stale.delete() }
        i = i + 1
    }

    var out = listOf<String>()
    if (width == 1) {
        val r0 = spawn statusSlot0()
        var s0 = "ERR:pending"
        try { s0 = "" + await r0 } catch (String e) { s0 = "ERR:" + classifyHttpErr(e) }
        if (count > 0) { out.add(s0) }
        return out
    }
    if (width == 2) {
        val r0 = spawn statusSlot0()
        val r1 = spawn statusSlot1()
        var s0 = "ERR:pending"
        var s1 = "ERR:pending"
        try { s0 = "" + await r0 } catch (String e) { s0 = "ERR:" + classifyHttpErr(e) }
        try { s1 = "" + await r1 } catch (String e) { s1 = "ERR:" + classifyHttpErr(e) }
        if (count > 0) { out.add(s0) }
        if (count > 1) { out.add(s1) }
        return out
    }
    if (width == 4) {
        val r0 = spawn statusSlot0()
        val r1 = spawn statusSlot1()
        val r2 = spawn statusSlot2()
        val r3 = spawn statusSlot3()
        var s0 = "ERR:pending"
        var s1 = "ERR:pending"
        var s2 = "ERR:pending"
        var s3 = "ERR:pending"
        try { s0 = "" + await r0 } catch (String e) { s0 = "ERR:" + classifyHttpErr(e) }
        try { s1 = "" + await r1 } catch (String e) { s1 = "ERR:" + classifyHttpErr(e) }
        try { s2 = "" + await r2 } catch (String e) { s2 = "ERR:" + classifyHttpErr(e) }
        try { s3 = "" + await r3 } catch (String e) { s3 = "ERR:" + classifyHttpErr(e) }
        if (count > 0) { out.add(s0) }
        if (count > 1) { out.add(s1) }
        if (count > 2) { out.add(s2) }
        if (count > 3) { out.add(s3) }
        return out
    }
    if (width == 8) {
        val r0 = spawn statusSlot0()
        val r1 = spawn statusSlot1()
        val r2 = spawn statusSlot2()
        val r3 = spawn statusSlot3()
        val r4 = spawn statusSlot4()
        val r5 = spawn statusSlot5()
        val r6 = spawn statusSlot6()
        val r7 = spawn statusSlot7()
        var s0 = "ERR:pending"
        var s1 = "ERR:pending"
        var s2 = "ERR:pending"
        var s3 = "ERR:pending"
        var s4 = "ERR:pending"
        var s5 = "ERR:pending"
        var s6 = "ERR:pending"
        var s7 = "ERR:pending"
        try { s0 = "" + await r0 } catch (String e) { s0 = "ERR:" + classifyHttpErr(e) }
        try { s1 = "" + await r1 } catch (String e) { s1 = "ERR:" + classifyHttpErr(e) }
        try { s2 = "" + await r2 } catch (String e) { s2 = "ERR:" + classifyHttpErr(e) }
        try { s3 = "" + await r3 } catch (String e) { s3 = "ERR:" + classifyHttpErr(e) }
        try { s4 = "" + await r4 } catch (String e) { s4 = "ERR:" + classifyHttpErr(e) }
        try { s5 = "" + await r5 } catch (String e) { s5 = "ERR:" + classifyHttpErr(e) }
        try { s6 = "" + await r6 } catch (String e) { s6 = "ERR:" + classifyHttpErr(e) }
        try { s7 = "" + await r7 } catch (String e) { s7 = "ERR:" + classifyHttpErr(e) }
        if (count > 0) { out.add(s0) }
        if (count > 1) { out.add(s1) }
        if (count > 2) { out.add(s2) }
        if (count > 3) { out.add(s3) }
        if (count > 4) { out.add(s4) }
        if (count > 5) { out.add(s5) }
        if (count > 6) { out.add(s6) }
        if (count > 7) { out.add(s7) }
        return out
    }
    // width == 16
    val r0 = spawn statusSlot0()
    val r1 = spawn statusSlot1()
    val r2 = spawn statusSlot2()
    val r3 = spawn statusSlot3()
    val r4 = spawn statusSlot4()
    val r5 = spawn statusSlot5()
    val r6 = spawn statusSlot6()
    val r7 = spawn statusSlot7()
    val r8 = spawn statusSlot8()
    val r9 = spawn statusSlot9()
    val r10 = spawn statusSlot10()
    val r11 = spawn statusSlot11()
    val r12 = spawn statusSlot12()
    val r13 = spawn statusSlot13()
    val r14 = spawn statusSlot14()
    val r15 = spawn statusSlot15()
    var s0 = "ERR:pending"
    var s1 = "ERR:pending"
    var s2 = "ERR:pending"
    var s3 = "ERR:pending"
    var s4 = "ERR:pending"
    var s5 = "ERR:pending"
    var s6 = "ERR:pending"
    var s7 = "ERR:pending"
    var s8 = "ERR:pending"
    var s9 = "ERR:pending"
    var s10 = "ERR:pending"
    var s11 = "ERR:pending"
    var s12 = "ERR:pending"
    var s13 = "ERR:pending"
    var s14 = "ERR:pending"
    var s15 = "ERR:pending"
    try { s0 = "" + await r0 } catch (String e) { s0 = "ERR:" + classifyHttpErr(e) }
    try { s1 = "" + await r1 } catch (String e) { s1 = "ERR:" + classifyHttpErr(e) }
    try { s2 = "" + await r2 } catch (String e) { s2 = "ERR:" + classifyHttpErr(e) }
    try { s3 = "" + await r3 } catch (String e) { s3 = "ERR:" + classifyHttpErr(e) }
    try { s4 = "" + await r4 } catch (String e) { s4 = "ERR:" + classifyHttpErr(e) }
    try { s5 = "" + await r5 } catch (String e) { s5 = "ERR:" + classifyHttpErr(e) }
    try { s6 = "" + await r6 } catch (String e) { s6 = "ERR:" + classifyHttpErr(e) }
    try { s7 = "" + await r7 } catch (String e) { s7 = "ERR:" + classifyHttpErr(e) }
    try { s8 = "" + await r8 } catch (String e) { s8 = "ERR:" + classifyHttpErr(e) }
    try { s9 = "" + await r9 } catch (String e) { s9 = "ERR:" + classifyHttpErr(e) }
    try { s10 = "" + await r10 } catch (String e) { s10 = "ERR:" + classifyHttpErr(e) }
    try { s11 = "" + await r11 } catch (String e) { s11 = "ERR:" + classifyHttpErr(e) }
    try { s12 = "" + await r12 } catch (String e) { s12 = "ERR:" + classifyHttpErr(e) }
    try { s13 = "" + await r13 } catch (String e) { s13 = "ERR:" + classifyHttpErr(e) }
    try { s14 = "" + await r14 } catch (String e) { s14 = "ERR:" + classifyHttpErr(e) }
    try { s15 = "" + await r15 } catch (String e) { s15 = "ERR:" + classifyHttpErr(e) }
    if (count > 0) { out.add(s0) }
    if (count > 1) { out.add(s1) }
    if (count > 2) { out.add(s2) }
    if (count > 3) { out.add(s3) }
    if (count > 4) { out.add(s4) }
    if (count > 5) { out.add(s5) }
    if (count > 6) { out.add(s6) }
    if (count > 7) { out.add(s7) }
    if (count > 8) { out.add(s8) }
    if (count > 9) { out.add(s9) }
    if (count > 10) { out.add(s10) }
    if (count > 11) { out.add(s11) }
    if (count > 12) { out.add(s12) }
    if (count > 13) { out.add(s13) }
    if (count > 14) { out.add(s14) }
    if (count > 15) { out.add(s15) }
    return out
}

