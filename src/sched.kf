// Progressive backoff for a retry attempt number (0-based): 200ms, 400ms,
// 800ms, capped.
Int backoffMs(Int attempt) {
    if (attempt <= 0) { return 200 }
    if (attempt == 1) { return 400 }
    return 800
}

// A single retrying status probe outside the batch machinery - used for
// control probes and for retrying an individual candidate that failed with
// a retryable (refused/timeout) error. Retries only ever repeat an
// idempotent GET/status check, never a mutating verb (dir mode never sends
// one).
String statusWithRetries(String url, Int maxRetries) {
    Path(slotStatusPath(0)).writeText(url)
    val r0 = spawn statusSlot0()
    var result = "ERR:pending"
    try { result = "" + await r0 } catch (String e) { result = "ERR:" + classifyHttpErr(e) }
    var attempt = 0
    while (result.startsWith("ERR:") && isRetryable(result) && attempt < maxRetries) {
        time.sleep(backoffMs(attempt))
        Path(slotStatusPath(0)).writeText(url)
        val r = spawn statusSlot0()
        try { result = "" + await r } catch (String e) { result = "ERR:" + classifyHttpErr(e) }
        attempt = attempt + 1
    }
    return result
}

// One-shot body-length fetch (no retries - used for control/baseline
// probes, which are already a handful of extra requests and don't need
// retry amplification).
String bodyLenOnce(String url) {
    Path(slotBodyPath(0)).writeText(url)
    val r0 = spawn bodySlot0()
    var result = "ERR:pending"
    try { result = "" + await r0 } catch (String e) { result = "ERR:" + classifyHttpErr(e) }
    return result
}

Bool isRetryable(String result) {
    if (result.contains("refused")) { return true }
    if (result.contains("timeout")) { return true }
    return false
}
