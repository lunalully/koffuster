// modes_tftp.kf - modo tftp: registrado com --help completo, mas se recusa
// a rodar honestamente.
//
// TFTP exige montar pacotes binários (byte[]) - e mesmo no KOF 0.5.0-beta,
// String.getBytes() ainda derruba o runtime (erro de JavaFX), e o FFI/
// extern documentado para o 0.5.0 não resolve no parser das builds
// atuais. Sem nenhuma das rotas, nenhum pacote TFTP pode ser montado.
// O modo imprime uma linha honesta no stderr e sai com código 3.

import kof.process

Bool runTftpMode(String[] args) {
    var cfg = parseModeArgs(args, 1, "tftp")

    if (cfg.help()) {
        println(tftpHelpText())
        return true
    }
    if (cfg.valid() == false) {
        log.error("koffuster tftp: " + cfg.errorMsg())
        process.exit(2)
        return false
    }

    log.error("koffuster tftp: TFTP/UDP não é suportado nas builds atuais do KOF (0.5.0-beta incluso): String.getBytes()/byte[] ainda derruba o runtime e o FFI/extern documentado para o 0.5.0 não resolveu no parser - não há como montar um pacote TFTP. Não implementado.")
    process.exit(3)
    return false
}