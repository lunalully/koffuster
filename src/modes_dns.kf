// modes_dns.kf - o driver do modo `dns`: subdomínios via resolver DoH JSON.

import kof.process

Bool runDnsMode(String[] args) {
    var cfg = parseModeArgs(args, 1, "dns")

    if (cfg.help()) {
        println(dnsHelpText())
        return true
    }
    if (cfg.valid() == false) {
        log.error("koffuster dns: " + cfg.errorMsg())
        process.exit(2)
        return false
    }

    var noColorEnv = envIsSet("NO_COLOR")
    printBanner(cfg.quiet(), false, cfg.format())
    if (cfg.verbose()) { log.error(configEcho(cfg)) }

    // Toda query DoH envia o mesmo header.
    var hdrs = buildHeaders(cfg.userAgent(), cfg.headers(), cfg.cookie(), "")
    http.timeout(cfg.timeoutSec())

    var startMs = time.now()
    var words = loadWordlist(cfg.wordlist())

    if (cfg.quiet() == false) {
        log.error("koffuster dns: " + words.size() + " candidatos, domínio " + cfg.domain() + ", resolver " + redactUrl(cfg.resolver()))
    }

    var width = snapThreads(cfg.threads())

    // -- detecção de wildcard: 3 nomes aleatórios; se todos resolverem
    // para o mesmo IP, esse IP é a assinatura e candidatos com ele são
    // descartados.
    var wildcardIp = ""
    var wildcardDetected = false
    var wcNames = listOf<String>()
    var wi = 0
    while (wi < 3) {
        wcNames.add(dnsControlToken(wi) + "." + cfg.domain())
        wi = wi + 1
    }
    var wcUrls = listOf<String>()
    var wj = 0
    while (wj < wcNames.size()) {
        wcUrls.add(dohQueryUrl(cfg.resolver(), wcNames.get(wj)))
        wj = wj + 1
    }
    var wcBodies = runBodyBatch(width, wcUrls, hdrs, true, wcUrls.size())
    var firstIp = ""
    var allSame = true
    var allResolved = true
    var wk = 0
    while (wk < wcBodies.size()) {
        var b = wcBodies.get(wk)
        if (b.startsWith("ERR:")) {
            allResolved = false
        } else {
            var st = dohStatusOf(b)
            if (st != 0) {
                allResolved = false
            } else {
                var ip = dohFirstIp(b)
                if (wk == 0) { firstIp = ip }
                if (ip != firstIp) { allSame = false }
            }
        }
        wk = wk + 1
    }
    if (allResolved && allSame && firstIp.length() > 0) {
        wildcardDetected = true
        wildcardIp = firstIp
    }
    if (cfg.verbose()) {
        if (wildcardDetected) {
            log.error("koffuster dns: wildcard detectado, IP=" + wildcardIp + " (candidatos com esse IP descartados)")
        } else {
            log.error("koffuster dns: sem wildcard detectado")
        }
    }

    var totalOps = 3
    var foundCount = 0
    var errorCount = 0
    var held = listOf<String>()
    var showProgress = (cfg.quiet() == false && words.size() >= 50)
    var lastBucket = -1

    var total = words.size()
    if (showProgress) {
        lastBucket = tickProgress(0, total, 0, lastBucket)
    }
    var idx = 0
    while (idx < total) {
        var count = width
        if (idx + count > total) { count = total - idx }

        var batchNames = listOf<String>()
        var batchUrls = listOf<String>()
        var j = 0
        while (j < count) {
            var name = words.get(idx + j) + "." + cfg.domain()
            batchNames.add(name)
            batchUrls.add(dohQueryUrl(cfg.resolver(), name))
            j = j + 1
        }

        var bodies = runBodyBatch(width, batchUrls, hdrs, true, count)
        totalOps = totalOps + count

        var m = 0
        while (m < count) {
            var body = bodies.get(m)
            var name = batchNames.get(m)
            if (body.startsWith("ERR:")) {
                var reason = body.substring(4)
                errorCount = errorCount + 1
                var outcome = "error"
                if (reason == "refused") { outcome = "resolver_down" }
                if (reason == "timeout") { outcome = "timeout" }
                if (cfg.verbose()) { log.error("erro: " + name + " -> " + outcome) }
            } else {
                var st = dohStatusOf(body)
                if (st == 0) {
                    var ip = dohFirstIp(body)
                    if (wildcardDetected && ip == wildcardIp) {
                        // descartado: casa com a assinatura do wildcard
                    } else {
                        foundCount = foundCount + 1
                        var okResult = DnsResult(name, "resolved", ip)
                        emitDnsResult(okResult, cfg, held)
                    }
                } else if (st == 3) {
                    if (cfg.verbose()) { log.error("nxdomain: " + name) }
                } else {
                    if (cfg.verbose()) { log.error("Status DoH inesperado " + st + " para " + name) }
                }
            }
            m = m + 1
        }

        idx = idx + count
        if (showProgress) {
            lastBucket = tickProgress(idx, total, foundCount, lastBucket)
        }
    }

    if (showProgress) {
        lastBucket = finishProgress(total, foundCount, lastBucket)
    }
    flushHeldResults(held)

    var durationMs = time.now() - startMs
    printSummary(cfg.quiet(), totalOps, foundCount, errorCount, durationMs)
    exitOnTotalFailure(foundCount, errorCount)
    return true
}

Bool emitDnsResult(DnsResult r, Config cfg, List<String> held) {
    var line = ""
    if (cfg.format() == "jsonl") {
        line = formatDnsJsonl(r)
    } else {
        line = formatDnsText(r)
    }
    held.add(line)
    if (cfg.output().length() > 0) {
        var fileLine = line
        if (cfg.format() != "jsonl") { fileLine = formatDnsText(r) }
        appendResultLine(cfg.output(), fileLine)
    }
    return true
}