// wordlist.kf - carrega uma wordlist (arquivo ou stdin) e expande
// extensões para o modo dir.
//
// Ainda não existe API de leitura em streaming no KOF: o arquivo inteiro
// (ou todo o stdin) é lido de uma vez, então wordlists muito grandes
// consomem memória proporcional ao tamanho. Limitação real, documentada.

import kof.process

List<String> loadWordlist(String pathOrDash) {
    var content = ""
    if (pathOrDash == "-") {
        var p = Path("/dev/stdin")
        if (p.exists()) {
            var c = p.readText()
            if (c != null) { content = c }
        }
    } else {
        var p = Path(pathOrDash)
        if (p.exists()) {
            var c = p.readText()
            if (c != null) { content = c }
        }
    }
    if (content.length() == 0) {
        log.error("koffuster: cannot read wordlist: " + pathOrDash)
        process.exit(2)
        return listOf<String>()
    }
    var rawLines = content.split("\n")
    var out = listOf<String>()
    var i = 0
    while (i < rawLines.length) {
        var line = rawLines[i]
        if (line.endsWith("\r")) {
            line = line.substring(0, line.length() - 1)
        }
        if (line.length() > 0) {
            out.add(line)
        }
        i = i + 1
    }
    return out
}

// "php,html" ou "" -> lista de extensões (aceita ".php" também).
List<String> parseExtensions(String csv) {
    var out = listOf<String>()
    if (csv.length() == 0) { return out }
    var parts = csv.split(",")
    var i = 0
    while (i < parts.length) {
        var e = parts[i].trim()
        if (e.startsWith(".")) { e = e.substring(1) }
        if (e.length() > 0) { out.add(e) }
        i = i + 1
    }
    return out
}

// Palavra pura primeiro, depois palavra.ext para cada extensão.
List<String> expandExtensions(List<String> words, List<String> exts) {
    var out = listOf<String>()
    var i = 0
    while (i < words.size()) {
        var w = words.get(i)
        out.add(w)
        var j = 0
        while (j < exts.size()) {
            out.add(w + "." + exts.get(j))
            j = j + 1
        }
        i = i + 1
    }
    return out
}