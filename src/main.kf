// main.kf - ponto de entrada, dispatch, --version, help top.

import kof.process

String versionString() {
    return "0.2.0"
}

main(args: String[]) {
    if (args.length == 0) {
        printTopHelp()
        return
    }
    var first = args[0]
    if (first == "--version") {
        println("koffuster " + versionString())
        return
    }
    if (first == "-h" || first == "--help") {
        printTopHelp()
        return
    }
    if (first == "help") {
        if (args.length < 2) {
            printTopHelp()
            return
        }
        printModeHelp(args[1])
        return
    }
    if (first == "dir") {
        runDirMode(args)
        return
    }
    if (first == "dns") {
        runDnsMode(args)
        return
    }
    if (first == "vhost") {
        runVhostMode(args)
        return
    }
    if (first == "fuzz") {
        runFuzzMode(args)
        return
    }
    if (first == "s3") {
        runS3Mode(args)
        return
    }
    if (first == "gcs") {
        runGcsMode(args)
        return
    }
    if (first == "tftp") {
        runTftpMode(args)
        return
    }
    log.error("koffuster: modo ou opção desconhecido: " + first)
    log.error("Uso: koffuster <modo> <alvo> <wordlist> [opções] | koffuster --help | koffuster help <modo>")
    process.exit(2)
}

Bool printTopHelp() {
    println("koffuster " + versionString() + " - enumeração ativa de terminal")
    println("")
    println("Uso:")
    println("  koffuster <modo> <alvo> <wordlist> [opções]")
    println("  koffuster help <modo>")
    println("")
    println("Modos:")
    println("  dir    força bruta de diretórios/arquivos")
    println("  dns    subdomínios via DNS-over-HTTPS")
    println("  vhost  virtual hosts via header Host")
    println("  fuzz   substituição de FUZZ em URL/cabeçalho/corpo")
    println("  s3     bucket S3 (somente leitura)")
    println("  gcs    bucket GCS (somente leitura)")
    println("  tftp   não suportado nesta build (veja 'koffuster help tftp')")
    println("")
    println("Resultados vão para stdout; banner, progresso e erros para stderr.")
    println("Exemplos:")
    println("  koffuster dir alvo.com.br words.txt")
    println("  koffuster dns exemplo.com subs.txt -f jsonl")
    return true
}

Bool printModeHelp(String mode) {
    if (mode == "dir") { println(dirHelpText()); return true }
    if (mode == "dns") { println(dnsHelpText()); return true }
    if (mode == "vhost") { println(vhostHelpText()); return true }
    if (mode == "fuzz") { println(fuzzHelpText()); return true }
    if (mode == "s3") { println(storeHelpText("s3", "http://%s.s3.amazonaws.com/")); return true }
    if (mode == "gcs") { println(storeHelpText("gcs", "https://storage.googleapis.com/%s/")); return true }
    if (mode == "tftp") { println(tftpHelpText()); return true }
    log.error("koffuster: modo desconhecido '" + mode + "' (modos: dir dns vhost fuzz s3 gcs tftp)")
    process.exit(2)
    return false
}