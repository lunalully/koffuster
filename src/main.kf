// main.kf - entry point, dispatch, --version, help.
//
// `System` does not resolve on this build at all (re-verified directly
// against the cookbook's own tests/stderr1/stderr1.kf, whose real output
// was never actually captured - see docs/impl-notes.md), so every stderr
// line here goes through `log.error` (proven - tests/logtest) rather than
// `System.err.println`. Non-zero exit codes go through `process.exit`
// (kof.process, proven working - tests/spike_exit3), since `System.exit`
// also fails to resolve.

import kof.process

String versionString() {
    return "0.1.0"
}

main(args: String[]) {
    if (args.length == 0) {
        printTopHelp()
        return
    }
    var first = args[0]
    if (first == "--version") {
        println("koffuster " + versionString())
        return
    }
    if (first == "-h" || first == "--help") {
        printTopHelp()
        return
    }
    if (first == "help") {
        if (args.length < 2) {
            printTopHelp()
            return
        }
        printModeHelp(args[1])
        return
    }
    if (first == "dir") {
        runDirMode(args)
        return
    }
    if (first == "dns") {
        runDnsMode(args)
        return
    }
    if (first == "vhost") {
        runVhostMode(args)
        return
    }
    if (first == "fuzz") {
        runFuzzMode(args)
        return
    }
    if (first == "s3") {
        runS3Mode(args)
        return
    }
    if (first == "gcs") {
        runGcsMode(args)
        return
    }
    if (first == "tftp") {
        runTftpMode(args)
        return
    }
    log.error("koffuster: unknown mode or option: " + first)
    log.error("Usage: koffuster <mode> [options] | koffuster --help | koffuster --version | koffuster help <mode>")
    process.exit(2)
}

Bool printTopHelp() {
    println("koffuster " + versionString() + " - terminal enumeration tool")
    println("")
    println("Usage:")
    println("  koffuster <mode> [options]")
    println("  koffuster --help | -h")
    println("  koffuster --version")
    println("  koffuster help <mode>")
    println("")
    println("Modes:")
    println("  dir    brute-force directories/files on a web target")
    println("  dns    subdomain enumeration via DNS-over-HTTPS")
    println("  vhost  virtual host enumeration via the Host header")
    println("  fuzz   FUZZ keyword substitution in URL/header/body")
    println("  s3     S3 bucket existence/permission check (read-only)")
    println("  gcs    GCS bucket existence/permission check (read-only)")
    println("  tftp   not supported on this KOF build (see 'koffuster help tftp')")
    println("")
    println("Results go to stdout; banner, progress, summary and errors go to stderr.")
    println("Run 'koffuster help <mode>' or 'koffuster <mode> --help' for every option,")
    println("its default, and examples.")
    println("")
    println("Examples:")
    println("  koffuster dir -u http://target/ -w words.txt")
    println("  koffuster dns -d example.com -w subs.txt --format jsonl")
    return true
}

Bool printModeHelp(String mode) {
    if (mode == "dir") { println(dirHelpText()); return true }
    if (mode == "dns") { println(dnsHelpText()); return true }
    if (mode == "vhost") { println(vhostHelpText()); return true }
    if (mode == "fuzz") { println(fuzzHelpText()); return true }
    if (mode == "s3") { println(storeHelpText("s3", "http://%s.s3.amazonaws.com/")); return true }
    if (mode == "gcs") { println(storeHelpText("gcs", "https://storage.googleapis.com/%s/")); return true }
    if (mode == "tftp") { println(tftpHelpText()); return true }
    log.error("koffuster: unknown mode '" + mode + "' (modes: dir dns vhost fuzz s3 gcs tftp)")
    process.exit(2)
    return false
}
