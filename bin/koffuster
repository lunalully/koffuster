#!/usr/bin/env bash
# bin/koffuster — launcher para a ferramenta de enumeração Koffuster.
#
# Responsabilidades:
#   - resolver seu próprio caminho real (funciona via symlink ou de qualquer
#     diretório de trabalho);
#   - localizar o módulo src/ (todos os .kf, um único main()) e um runtime
#     KOF para executá-lo;
#   - exportar a flag JVM que o modo vhost precisa
#     (-Djdk.httpclient.allowRestrictedHeaders=host, obrigatória para
#     sobrescrever o header Host);
#   - apontar KOFFUSTER_BANNER para o banner.txt instalado;
#   - mapear --proxy para as propriedades http(s).proxyHost/proxyPort da JVM;
#   - exec o runtime no módulo, repassando os argumentos sem alteração.

set -euo pipefail

resolve_self() {
    local src="${BASH_SOURCE[0]}"
    while [ -h "$src" ]; do
        local dir
        dir="$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)"
        src="$(readlink "$src")"
        case "$src" in
            /*) ;;
            *) src="$dir/$src" ;;
        esac
    done
    cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd
}

BIN_DIR="$(resolve_self)"
INSTALL_ROOT="$(cd "$BIN_DIR/.." >/dev/null 2>&1 && pwd)"

SRC_DIR="$INSTALL_ROOT/src"
MAIN_FILE="$SRC_DIR/main.kf"
BANNER_FILE="$INSTALL_ROOT/banner.txt"

if [ ! -f "$MAIN_FILE" ]; then
    echo "koffuster: cannot find installed source at $MAIN_FILE" >&2
    exit 1
fi

# Só a flag do vhost: o KOF 0.5.0 roda sem --enable-preview (o CLI usa a
# JVM embutida da distribuição).
export JDK_JAVA_OPTIONS="-Djdk.httpclient.allowRestrictedHeaders=host ${JDK_JAVA_OPTIONS:-}"
export KOFFUSTER_BANNER="$BANNER_FILE"

# --proxy <url> -> propriedades http(s).proxyHost/proxyPort da JVM.
for ((i = 1; i <= $#; i++)); do
    arg="${!i}"
    if [ "$arg" = "--proxy" ]; then
        next=$((i + 1))
        proxy_url="${!next:-}"
        if [ -n "$proxy_url" ]; then
            hostport="${proxy_url#*://}"
            phost="${hostport%%:*}"
            pport="${hostport##*:}"
            if [ -n "$phost" ] && [ -n "$pport" ] && [ "$pport" != "$hostport" ]; then
                export JDK_JAVA_OPTIONS="$JDK_JAVA_OPTIONS -Dhttp.proxyHost=$phost -Dhttp.proxyPort=$pport -Dhttps.proxyHost=$phost -Dhttps.proxyPort=$pport"
            fi
        fi
    elif [[ "$arg" == --proxy=* ]]; then
        proxy_url="${arg#--proxy=}"
        hostport="${proxy_url#*://}"
        phost="${hostport%%:*}"
        pport="${hostport##*:}"
        if [ -n "$phost" ] && [ -n "$pport" ] && [ "$pport" != "$hostport" ]; then
            export JDK_JAVA_OPTIONS="$JDK_JAVA_OPTIONS -Dhttp.proxyHost=$phost -Dhttp.proxyPort=$pport -Dhttps.proxyHost=$phost -Dhttps.proxyPort=$pport"
        fi
    fi
done

# Limpa o stderr do filho: remove os avisos "Picked up JDK_JAVA_OPTIONS"
# da JVM e o prefixo timestamp+nível que o log.error do runtime adiciona.
# O stdout nunca é tocado.
exec 2> >(trap '' INT; exec sed -u -E -e '/^(NOTE: )?Picked up (JDK_JAVA_OPTIONS|JAVA_TOOL_OPTIONS|_JAVA_OPTIONS):/d' -e 's/^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}([.,][0-9]+)? [A-Z]+ //' >&2)

if [ -n "${KOFFUSTER_KOF_JAR:-}" ]; then
    exec java -jar "$KOFFUSTER_KOF_JAR" run "$MAIN_FILE" "$@"
elif [ -n "${KOF_HOME:-}" ] && [ -x "$KOF_HOME/bin/kof" ]; then
    exec "$KOF_HOME/bin/kof" run "$MAIN_FILE" "$@"
elif command -v kof >/dev/null 2>&1; then
    exec kof run "$MAIN_FILE" "$@"
else
    echo "koffuster: no KOF runtime found (looked for \$KOFFUSTER_KOF_JAR, \$KOF_HOME/bin/kof, and 'kof' on PATH)" >&2
    exit 1
fi